{
  "name": "lunaby",
  "version": "3.0.0-native",
  "description": "Bot Discord hỗ trợ trò chuyện AI và tạo hình ảnh, phiên bản native chỉ dùng cho model Lunaby",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run bot",
    "bot": "node shard.js",
    "bot:dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "dashboard": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:preview": "npm --prefix dashboard run preview",
    "dashboard:prod": "npm --prefix dashboard run build && npm --prefix dashboard run prod",
    "all": "concurrently \"npm run bot\" \"npm run dashboard\"",
    "all:preview": "concurrently \"npm run bot\" \"npm run dashboard:preview\"",
    "all:prod": "concurrently \"npm run bot\" \"npm run dashboard:prod\"",
    "dev": "npm run bot:dev"
  },
  "author": {
    "name": "s4ory"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lun4by/Lunaby.git"
  },
  "dependencies": {
    "@gradio/client": "^2.1.0",
    "@top-gg/sdk": "^3.1.6",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "i18next": "^26.0.4",
    "lunaby-canvas": "github:lun4by/Lunaby-canvas",
    "lunaby-sdk": "^2.1.1",
    "mariadb": "^3.5.2",
    "mongodb": "^7.1.1",
    "topgg-autoposter": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14"
  }
}
