# === Lunaby ===
LUNABY_BASE_URL=https://api.lunie.dev/v1
LUNABY_API_KEY=api_key_here
# Optional: Override default model (defaults to lunaby-pro)
# LUNABY_MODEL=lunaby-pro
# Optional: Enable/disable streaming (defaults to true)
# Set to 'false' to disable streaming and use non-streaming responses
ENABLE_STREAMING=true
# Dev only: verify translation keys used in command files during startup.
# Runs only in dev mode (`npm run dev` or NODE_ENV=development).
# I18N_VERIFY_ON_START=true
# I18N_STRICT=true

# === Fonts / Canvas ===
# Set only if fontconfig needs an explicit config path in your environment.
# FONTCONFIG_PATH=/etc/fonts
# FC_DEBUG=0

# === Dashboard ===
# CLIENT_SECRET=discord_client_secret_here
# CALLBACK_URL=http://localhost:3000/login/api
# DASHBOARD_PORT=3000
# NUXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

